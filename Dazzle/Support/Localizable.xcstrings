    "SlideSize.Scaling.Maximize" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximise"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大化"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대화"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大化"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大化"
          }
        }
      }
    },
    "SlideSize.Scaling.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximise fills the new size, which may cut off some content. Ensure Fit shrinks content so it all stays on the slide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最大化」では新しいサイズいっぱいに拡大され、コンテンツの一部がはみ出す場合があります。「サイズに合わせて調整」ではすべてのコンテンツがスライドに収まるよう縮小されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대화는 새 크기를 채우므로 일부 콘텐츠가 잘릴 수 있습니다. 맞춤 확인은 모든 콘텐츠가 슬라이드에 남도록 축소합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“最大化”会填满新尺寸，部分内容可能会被裁掉。“确保适合”会缩小内容，使其全部保留在幻灯片上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最大化」會填滿新尺寸，部分內容可能會被裁切。「確保最適大小」會縮小內容，使其全部保留在投影片上。"
          }
        }
      }
    },
