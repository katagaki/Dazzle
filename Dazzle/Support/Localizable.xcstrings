    "HeaderFooter.Footer.Note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each appears where the slide’s layout puts it. A layout with no place for one leaves it off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各項目はスライドのレイアウトで指定された位置に表示されます。レイアウトに配置場所がない項目は表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목은 슬라이드 레이아웃이 지정한 위치에 표시됩니다. 레이아웃에 자리가 없으면 표시되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每项都显示在幻灯片版式指定的位置。版式中没有其位置的项不会显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每項都會顯示在投影片版面配置指定的位置。版面配置中沒有其位置的項目不會顯示。"
          }
        }
      }
