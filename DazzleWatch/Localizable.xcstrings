    "Remote.Idle.Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a presentation in Dazzle on your iPhone to control it from here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのDazzleでプレゼンテーションを開くと、ここから操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 Dazzle에서 프레젠테이션을 열면 여기에서 제어할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的 Dazzle 中打开演示文稿，即可在此控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上的 Dazzle 中打開簡報，即可在此控制。"
          }
        }
      }
    },
    "Remote.Idle.Title": {
      "extractionState": "manual",
      "localizations": {
