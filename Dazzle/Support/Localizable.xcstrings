    "Advance.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a slideshow, the slide moves on by itself after this time. Videos made from the presentation use it too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スライドショーでは、この時間が経過するとスライドが自動的に切り替わります。プレゼンテーションから作成したビデオでも使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "슬라이드쇼에서 이 시간이 지나면 슬라이드가 자동으로 넘어갑니다. 프레젠테이션으로 만든 비디오에도 사용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放映时，幻灯片会在此时间后自动切换。用演示文稿制作的视频也会使用此时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放映時，投影片會在此時間後自動切換。用簡報製作的影片也會使用此時間。"
          }
        }
      }
    },
