    "Notice.Feature.Charts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charts are kept, and shown as placeholders."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グラフは保持され、プレースホルダとして表示されます。"
          }
