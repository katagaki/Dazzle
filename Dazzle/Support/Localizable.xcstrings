    "Error.UnreadablePicture" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That picture couldn’t be read. Try a PNG or JPEG."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その画像を読み込めませんでした。PNGまたはJPEGをお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 사진을 읽을 수 없습니다. PNG 또는 JPEG를 사용해 보십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取该图片。请尝试 PNG 或 JPEG。"
